# === YouTube Data API v3 ===
YOUTUBE_API_KEY=

# === Database (Postgres) ===
# ローカル docker-compose を使う場合はこのままでOK
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nonvtuber_live

# === サーバー ===
PORT=3000

# === 管理API保護用トークン（申請の承認/却下、手動実行に使用） ===
ADMIN_TOKEN=change-me-to-a-random-string

# === 1日のクォータ上限（デフォルト10000のうち安全マージンを見て9000） ===
QUOTA_DAILY_LIMIT=9000

# === 発見フェーズ（新規チャンネル探索）===
# cron形式。デフォルトは2時間おき
DISCOVERY_CRON=0 */2 * * *
# カンマ区切りの検索キーワード（VTuberという単語は入れない）
DISCOVERY_KEYWORDS=雑談配信,顔出し配信,ゲーム実況 ライブ,歌枠 生放送,ライブ配信中,フリートーク 配信

# === 監視フェーズ（登録済み配信の同接数更新）===
# デフォルトは10分おき
MONITOR_CRON=*/10 * * * *

# === 表示フィルタ ===
# 同時視聴者数がこの人数以上の配信は一覧・件数から除外する（「同接少なめ」に特化するため）
MAX_CONCURRENT_VIEWERS=10
# 配信開始からこの時間数（時間）を超えて続いている配信（耐久配信等）は一覧・件数から除外する
MAX_LIVE_HOURS=48
# 同接数フィルタを無視して常に一覧の上位に固定表示するチャンネル（@handle、カンマ区切り）
PINNED_CHANNEL_HANDLES=@matomonaka,@toakun_dayo
